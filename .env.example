# Copy to .env (project root) and fill real values. Never commit .env.
# Legacy path config/.env is deprecated — use <repo>/.env (loaded by config/settings.py).

# Django
DJANGO_SECRET_KEY=change-me-generate-a-strong-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Cairo

# LLM routing (openai | gemini | deepseek)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDINGS_MODEL=models/gemini-embedding-001

# DeepSeek via OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat-v3.1:free

# Vector DB
CHROMA_DB_DIR=.chroma

# WhatsApp gateway (optional — required only for check_whatsapp command)
WHATSAPP_BASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_SESSION_ID=

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default_cs
